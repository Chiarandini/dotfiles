<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.yabai-watchdog</string>

    <!--
        Path uses a placeholder substituted by install.sh at install time so
        these dotfiles are portable across machines with different usernames.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/yabai-watchdog</string>
    </array>

    <key>StartInterval</key>
    <integer>15</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/yabai-watchdog.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/yabai-watchdog.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
