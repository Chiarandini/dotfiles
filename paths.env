# Single source of truth for movable content roots.
#
# Reference these ($TEXTBOOKS, $PAPERS, ...) from shell, nvim (os.getenv),
# and Claude skills instead of hard-coding paths. When you reorganize, edit
# ONE line here and everything that goes through the anchor follows.
#
# This is NOT a registry of references (that would drift) — it DEFINES each
# root once. For the long tail that can't read an env var (docs, notes),
# don't track them: run `whereref <path-fragment>` at move time.

export ACADEMIC="$HOME/Documents/academic"
export TEXTBOOKS="$ACADEMIC/textbooks"
export PAPERS="$ACADEMIC/papers"
export PRESENTATIONS="$ACADEMIC/presentations"
export RESEARCH="$ACADEMIC/research"
export VAULT="$HOME/Documents/vault"
