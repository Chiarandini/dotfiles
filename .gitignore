# ── Local-only / per-machine state ────────────────────────────────────────────
**/.claude/
zsh/work.zsh
# Deliberately disposable scratch config (see the `tmpnvim` alias in .zshrc)
tmpnvim/
**/spell/*.add
**/spell/*.add.spl
nvim/preamble/personal-info.tex

# ── Secrets & auth state ──────────────────────────────────────────────────────
# ntfy topic names are bearer secrets: knowing one is enough to read and post
# to that channel, so the constellation agents' topics stay machine-local.
**/ntfy-topic
**/secrets.lua
**/secrets.zsh
gh/hosts.yml
gh/config.yml
# Holds a live OAuth token, refreshed on use. Was tracked until 2026-08-10;
# older tokens remain in history, so revoke rather than trust the untracking.
rclone/rclone.conf
github-copilot/
raycast/config.json
raycast/ai/
spotify-tui/
**/configs/calendar.lua

# ── Raycast (app state, user-managed, not dotfiles) ───────────────────────────
# The whole directory rather than its subfolders. `raycast/extensions/` was
# listed on its own until 2026-08-22, which left `raycast/node-compile-cache/`
# addable -- V8 cache blobs that `git add .` would have published to what is a
# PUBLIC repo. Naming subfolders means every new one Raycast invents is exposed
# until someone notices; nothing under here is worth tracking, so ignore the lot.
raycast/
# Compiled extension bundles + node compile cache: 1.3 GB of minified JS that
# Raycast regenerates on install/update. Not config, and it churned on every
# extension update.
raycast-x/

# ── Backup repos (independent git repos; pushed separately) ───────────────────
nvim.bak/
nvim.bak-old/

# tmux plugins are vendored, not cloned: see tmux/plugins/VENDORED.md. The old
# rule here assumed TPM would clone them on first start, which silently never
# happened and left tmux-resurrect inert from 2023 to 2026.

# ── Backup files ──────────────────────────────────────────────────────────────
*.bak
*~

# ── Runtime logs ──────────────────────────────────────────────────────────────
*.log

# ── Caches ────────────────────────────────────────────────────────────────────
*.cache
cache/
.cache/
**/.mypy_cache/
**/__pycache__/
*.pyc

# ── ctags (generated, can be huge) ────────────────────────────────────────────
tags

# ── Editor swap ───────────────────────────────────────────────────────────────
*.swp
*.swo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?

# ── Google Drive temp ─────────────────────────────────────────────────────────
.tmp.drivedownload/
.tmp.driveupload/
