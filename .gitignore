# ── Local-only / per-machine state ────────────────────────────────────────────
**/.claude/
zsh/work.zsh
# Deliberately disposable scratch config (see the `tmpnvim` alias in .zshrc)
tmpnvim/
**/spell/*.add
**/spell/*.add.spl
nvim/preamble/personal-info.tex

# ── Secrets & auth state ──────────────────────────────────────────────────────
# ntfy topic names are bearer secrets: knowing one is enough to read and post
# to that channel, so the constellation agents' topics stay machine-local.
**/ntfy-topic
**/secrets.lua
**/secrets.zsh
gh/hosts.yml
gh/config.yml
github-copilot/
raycast/config.json
raycast/ai/
spotify-tui/
**/configs/calendar.lua

# ── Raycast extensions (user-managed, not dotfiles) ───────────────────────────
raycast/extensions/
# Compiled extension bundles + node compile cache: 1.3 GB of minified JS that
# Raycast regenerates on install/update. Not config, and it churned on every
# extension update.
raycast-x/

# ── Backup repos (independent git repos; pushed separately) ───────────────────
nvim.bak/
nvim.bak-old/

# ── tmux plugins (managed by TPM, auto-cloned on first tmux start) ────────────
tmux/plugins/

# ── Backup files ──────────────────────────────────────────────────────────────
*.bak
*~

# ── Runtime logs ──────────────────────────────────────────────────────────────
*.log

# ── Caches ────────────────────────────────────────────────────────────────────
*.cache
cache/
.cache/
**/.mypy_cache/
**/__pycache__/
*.pyc

# ── ctags (generated, can be huge) ────────────────────────────────────────────
tags

# ── Editor swap ───────────────────────────────────────────────────────────────
*.swp
*.swo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?

# ── Google Drive temp ─────────────────────────────────────────────────────────
.tmp.drivedownload/
.tmp.driveupload/
